# API Configuration (REQUIRED)
# Copy this file to .env and fill in your actual values
# Production: the sync runs on the same server as Domingo às Dez, so call the app directly with
# API_BASE_URL=http://127.0.0.1:3003/api. Going through https://domingoasdez.com/api passes
# Cloudflare, whose Bot Fight Mode blocks the server.
API_BASE_URL=http://localhost:8000/api
API_TOKEN=your_api_token_here

# Output Configuration (OPTIONAL)
OUTPUT_DIR=./data
PLAYERS_FILE=players.jsonl

# Pagination Settings (OPTIONAL)
DEFAULT_PER_PAGE=100

# Web Scraping Configuration (OPTIONAL)
CLUBS_LIST_URL=https://afpbarcelos.pt/clubes
